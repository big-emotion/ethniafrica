# Copy to .env on the host (/srv/plausible/.env) and fill in. Never commit the real .env —
# see docs/runbooks/plausible-self-hosted.md for how the secrets below are generated on the
# host itself rather than passed through a chat session or committed anywhere.

# The public URL of the analytics dashboard/collector. Must match the DNS record pointing
# at this VPS and the Traefik router rule in docker-compose.yml.
BASE_URL=https://stats.ethniafrica.com

# Required, >= 64 bytes. Generate on the host with: openssl rand -base64 48
SECRET_KEY_BASE=

# Optional — derived from SECRET_KEY_BASE if unset. Generate on the host with:
# openssl rand -base64 32
TOTP_VAULT_KEY=

# invite_only (default) lets only the very first account self-register at $BASE_URL/register;
# every account after that needs an invite from inside the dashboard.
DISABLE_REGISTRATION=invite_only
