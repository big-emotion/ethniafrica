# ──────────────────────────────────────────────────────────────────────────────
# EthniAfrica — canonical example env file
# Copy to `.env.local` for local development. Every `process.env.X` reference in
# `src/`, `scripts/`, `e2e/` and the root config files is documented here, and
# every entry here is read by something — `npm run check:env-example` enforces
# both directions.
# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────
# Site identity (required for SEO, canonical URLs, OG tags)
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ethniafrica.com
NEXT_PUBLIC_CANONICAL_DOMAIN=ethniafrica.com
NEXT_PUBLIC_PRODUCT_NAME="EthniAfrica"
NEXT_PUBLIC_SITE_LOCALE=fr_FR
NEXT_PUBLIC_OG_TITLE="EthniAfrica — données ouvertes sur les peuples d'Afrique"
NEXT_PUBLIC_OG_DESCRIPTION=""
NEXT_PUBLIC_ATTRIBUTION_STRING="BIG EMOTION"

# ──────────────────────────────────────────────────────────────────────────────
# Supabase (required)
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Never expose in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
# SERVER-ONLY. The Supabase project backing the PRODUCTION application — a different
# project from the values above, which are recette's. Required only to run the AFRIK
# corpus sync with `--target=production`, where it must equal NEXT_PUBLIC_SUPABASE_URL;
# there is no default, and the recette ref is refused.
# In CI this comes from the PRODUCTION_SUPABASE_URL repository secret, paired with
# PRODUCTION_SUPABASE_SERVICE_ROLE_KEY (the same project's service-role key), both read
# only by .github/workflows/production-data-sync.yml.
AFRIK_PRODUCTION_SUPABASE_URL=https://your-production-project.supabase.co

# ──────────────────────────────────────────────────────────────────────────────
# Cache revalidation (required)
# ──────────────────────────────────────────────────────────────────────────────
REVALIDATE_SECRET=
# SERVER-ONLY (required to use the Supabase database webhook). Shared secret
# the webhook sends as `Authorization: Bearer <secret>` to
# POST /api/internal/revalidate; the route answers 401 while it is unset.
SUPABASE_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# CORS (optional — defaults to NEXT_PUBLIC_SITE_URL)
# ──────────────────────────────────────────────────────────────────────────────
# Allowed browser origin for the public API. With neither this nor
# NEXT_PUBLIC_SITE_URL set, credentialed cross-origin calls are refused.
CORS_ALLOWED_ORIGIN=

# ──────────────────────────────────────────────────────────────────────────────
# Rate limiting — Upstash Redis (required in production for /api/v2/*)
# ──────────────────────────────────────────────────────────────────────────────
# When both vars are missing, rate limiting fails OPEN in non-production
# (see src/lib/api/rate-limit.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tier is read from the validated api_keys.tier DB column (migration 013),
# not from env vars — see validateApiKey() in src/lib/api/auth.ts.

# Per-tier requests-per-minute quotas. Defaults preserve current behavior.
RATE_LIMIT_IP_RPM=60
RATE_LIMIT_PUBLIC_RPM=600
RATE_LIMIT_PARTNER_RPM=6000
# Window duration accepted by @upstash/ratelimit (e.g. "1 m", "30 s").
RATE_LIMIT_WINDOW=1 m

# ──────────────────────────────────────────────────────────────────────────────
# Anti-bot control — proof of work, no third party
# ──────────────────────────────────────────────────────────────────────────────
# Reporting an error needs no account, so this is what stands between a bot and
# the public register at /fr/signalements. It replaced Cloudflare Turnstile: the
# reader's browser solves a small computation and this service verifies it, so
# nothing about a visitor — not even an IP — leaves the infrastructure (DEC-009).
#
# SERVER-ONLY. Any long random string. Rotating it invalidates challenges that
# are in flight, which is harmless: the reader is handed a new one.
ANTIBOT_HMAC_SECRET=
# Leading zero bits a browser must find before it may submit. Higher costs a bot
# more, and a reader too — measure on a low-end phone before raising it.
# Defaults to 20 (about a second on a desktop) when unset.
ANTIBOT_DIFFICULTY_BITS=

# ──────────────────────────────────────────────────────────────────────────────
# Sentry — EU data residency (GDPR NFR34 / AR28 / AR38)
# ──────────────────────────────────────────────────────────────────────────────
# Both DSN values MUST use the EU ingestion hostname:
#   https://o<org-id>.ingest.de.sentry.io/<project-id>
# Using a US DSN (ingest.sentry.io) throws at startup in production and
# warns in development (see src/lib/sentry/pii-scrubber.ts).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Required for build-step source-map upload (set in CI/CD, never commit).
SENTRY_AUTH_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# Plausible Analytics — cookie-less, EU-hosted (GDPR AR26 / AR37 / NFR42)
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional — override script host for self-hosted Plausible.
NEXT_PUBLIC_PLAUSIBLE_CUSTOM_DOMAIN=

# ──────────────────────────────────────────────────────────────────────────────
# Flag resolution email — Resend (optional, ETNI-73)
# ──────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY. Sends the contributor a notification when a flag they filed is
# accepted, rejected or marked duplicate (see src/lib/email/flagNotification.ts).
# Unset, the notification is logged and skipped rather than sent — the flag
# transition itself is never blocked on this.
RESEND_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Quiz (optional)
# ──────────────────────────────────────────────────────────────────────────────
# No variable decides whether a feature is shown. A module the code declares is
# listed and linked; whether it has anything to serve is read from the corpus,
# never from the environment.
# Optional — minimum fiche confidence (0-100) a fiche needs to be quizzable.
# Defaults to 80 (see src/lib/quiz/eligibility.ts).
QUIZ_MIN_CONFIDENCE=

# ──────────────────────────────────────────────────────────────────────────────
# Editorial doctrine (optional)
# ──────────────────────────────────────────────────────────────────────────────
# Overrides the changelog link on /fr/doctrine/<slug>. Defaults to the GitHub
# commit history of supabase/migrations/018_editorial_doctrine_seed.sql.
NEXT_PUBLIC_DOCTRINE_CHANGELOG_URL=

# ──────────────────────────────────────────────────────────────────────────────
# End-to-end tests and local tooling (optional — all have working defaults)
# ──────────────────────────────────────────────────────────────────────────────
# Base URL Playwright drives. Defaults to http://localhost:3000.
BASE_URL=
# Set to any value to run Playwright against an already-running server instead of
# letting it start one.
SKIP_WEB_SERVER=
# Inbucket, the local mail catcher `supabase start` runs. Defaults to
# http://localhost:54324. The auth specs read magic links from it.
# Overrides the Supabase origin the e2e admin client uses. Falls back to
# NEXT_PUBLIC_SUPABASE_URL, which is what you normally want.
SUPABASE_URL=

# ──────────────────────────────────────────────────────────────────────────────
# Deployment runtime (optional — Vercel injects this, leave empty elsewhere)
# ──────────────────────────────────────────────────────────────────────────────
# `production` / `preview` / `development`. Only `production` counts as a real
# production deployment for rate limiting (see src/lib/api/rate-limit.ts).
VERCEL_ENV=

# ──────────────────────────────────────────────────────────────────────────────
# Admin (optional)
# ──────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=

# ──────────────────────────────────────────────────────────────────────────────
# CI / contract tests (optional — only set in CI)
# ──────────────────────────────────────────────────────────────────────────────
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_KEY=
TEST_JWT_ADMIN=
TEST_JWT_MODERATOR=
TEST_JWT_CONTRIBUTOR=
TEST_JWT_READER=
# Allow contract suite to record breaking changes intentionally.
API_BREAKING=
# Enable HEAD probes on source URLs in data-integrity job.
CHECK_SOURCE_URLS=
# Base URL of a running app for the axe live-route sweep (scripts/a11y-test.ts).
# Unset, the live routes are skipped and only the static audit runs.
A11Y_LIVE_BASE_URL=

# --- Deployment-tunable limits (optional; documented defaults in code) ---
# Reports one reporter may file per window. Raise for a launch or a moderation
# campaign, lower during an abuse wave. Defaults: 10 hourly, 30 daily.
FLAG_RATE_LIMIT_HOURLY=
FLAG_RATE_LIMIT_DAILY=
# Deadline on every server-side Supabase request, in milliseconds. A deployment
# further from its database needs a higher ceiling. Default: 10000.
SUPABASE_REQUEST_TIMEOUT_MS=

# --- Reading the production schema ledger (CI only; never set these locally) ---
# `npm run check:migration-state:production` reads production's own
# supabase_migrations ledger through applied_migrations() (migration 042), so a
# release measures the schema instead of trusting a runbook. Supplied to the
# `schema` job of deploy-production.yml as repository secrets; leave blank here.
PRODUCTION_SUPABASE_URL=
PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=
