{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/lint-edited-file.sh",
            "timeout": 60,
            "statusMessage": "Linting edited file..."
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/setup-worktree.sh",
            "timeout": 300,
            "statusMessage": "Provisioning worktree (node_modules, env)..."
          }
        ]
      }
    ]
  }
}
