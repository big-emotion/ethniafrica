{
  "name": "ethniafrica",
  "private": true,
  "version": "3.0.0",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ src scripts",
    "lint:fix": "npm run lint -- --fix",
    "lint:req": "tsx scripts/lintReqAnnotations.ts",
    "lint:req:staged": "tsx scripts/lintReqAnnotations.ts --staged",
    "check:jira-template": "tsx scripts/checkJiraTemplate.ts",
    "check:action-pins": "tsx scripts/checkGithubActionPins.ts",
    "check:env-example": "tsx scripts/checkEnvExample.ts",
    "check:migration-state": "tsx scripts/ci/checkMigrationState.ts",
    "check:migration-files": "tsx scripts/ci/checkMigrationState.ts --files-only",
    "migrations:diff": "tsx scripts/migrationsDiff.ts",
    "check:pagination-contract": "tsx scripts/checkPaginationContractDrift.ts",
    "confluence:bootstrap:build": "tsx scripts/buildConfluenceBootstrap.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "typecheck": "tsc --noEmit",
    "type-check": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "unit-tests": "vitest run --dir src/lib",
    "integration-tests": "vitest run --dir src/app/api",
    "api-tests": "vitest run --dir src/app/api/v2",
    "all-tests": "vitest run",
    "test:charter-contracts": "tsx scripts/runCharterContracts.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:a11y": "npx playwright install chromium && tsx scripts/a11y-test.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:report": "playwright show-report playwright-report",
    "audit:people-sources": "tsx scripts/audit/runPeopleSourceTierAudit.ts",
    "bundle-size:quiz": "tsx scripts/quiz-bundle-size.ts",
    "bundle-size:home-globe": "tsx scripts/home-globe-bundle-size.ts",
    "bundle-size:axis-graph": "tsx scripts/axis-graph-bundle-size.ts",
    "openapi:generate": "tsx scripts/generate-openapi-spec.ts",
    "openapi:diff": "tsx scripts/openapi-diff.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.100.10",
    "@types/archiver": "^7.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "archiver": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.0",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.18.0",
    "next": "^16.0.8",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.30.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^8.6.17",
    "@storybook/addon-essentials": "^8.6.17",
    "@storybook/addon-interactions": "^8.6.17",
    "@storybook/blocks": "^8.6.17",
    "@storybook/react": "^8.6.17",
    "@storybook/react-vite": "^8.6.17",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "4.1.6",
    "@vitest/ui": "^4.1.6",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.12.1",
    "baseline-browser-mapping": "^2.10.30",
    "dotenv": "^17.4.2",
    "eslint": "^9.32.0",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "marked": "^18.0.5",
    "postcss": "^8.5.6",
    "prettier": "3.8.3",
    "puppeteer": "^25.1.0",
    "storybook": "^8.6.17",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.6"
  }
}
