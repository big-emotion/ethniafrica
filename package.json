{
  "name": "ethniafrica",
  "private": true,
  "version": "4.1.0",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ src scripts",
    "lint:fix": "npm run lint -- --fix",
    "lint:req": "tsx scripts/lintReqAnnotations.ts",
    "lint:req:staged": "tsx scripts/lintReqAnnotations.ts --staged",
    "check:jira-template": "tsx scripts/checkJiraTemplate.ts",
    "check:action-pins": "tsx scripts/checkGithubActionPins.ts",
    "check:workflow-shell": "tsx scripts/checkWorkflowShellSyntax.ts",
    "check:dead": "tsx scripts/ci/checkDeadCode.ts",
    "check:env-example": "tsx scripts/checkEnvExample.ts",
    "check:afrik-loader": "tsx scripts/ci/checkAfrikLoaderPreflight.ts",
    "check:migration-state": "tsx scripts/ci/checkMigrationState.ts",
    "check:migration-state:production": "tsx scripts/ci/checkMigrationState.ts --target=production",
    "check:migration-files": "tsx scripts/ci/checkMigrationState.ts --files-only",
    "migrations:diff": "tsx scripts/migrationsDiff.ts",
    "check:pagination-contract": "tsx scripts/checkPaginationContractDrift.ts",
    "confluence:bootstrap:build": "tsx scripts/buildConfluenceBootstrap.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "typecheck": "tsc --noEmit",
    "type-check": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "unit-tests": "vitest run --dir src/lib",
    "integration-tests": "vitest run --dir src/app/api",
    "api-tests": "vitest run --dir src/app/api/v2",
    "all-tests": "vitest run",
    "test:charter-contracts": "tsx scripts/runCharterContracts.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:a11y": "npx playwright install chromium && tsx scripts/a11y-test.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:report": "playwright show-report playwright-report",
    "audit:people-sources": "tsx scripts/audit/runPeopleSourceTierAudit.ts",
    "bundle-size:quiz": "tsx scripts/quiz-bundle-size.ts",
    "bundle-size:home-globe": "tsx scripts/home-globe-bundle-size.ts",
    "bundle-size:axis-graph": "tsx scripts/axis-graph-bundle-size.ts",
    "openapi:generate": "tsx scripts/generate-openapi-spec.ts",
    "openapi:diff": "tsx scripts/openapi-diff.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
