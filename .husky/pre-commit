echo "🔍 Running pre-commit checks..."

# Vérifier les types TypeScript
echo "📝 Checking TypeScript types..."
npm run type-check || {
  echo "❌ TypeScript type checking failed"
  exit 1
}

# Linter les fichiers modifiés
echo "🔧 Running ESLint on staged files..."
npx lint-staged || {
  echo "❌ Linting failed"
  exit 1
}

# Un dépôt public ne porte aucun chemin local. Contrôle, pas bonne intention.
echo "🔒 Checking for local paths..."
npx tsx scripts/ci/checkLocalPaths.ts --staged || {
  echo "❌ A local path would be committed to a public repository"
  exit 1
}

echo "✅ All pre-commit checks passed!"
